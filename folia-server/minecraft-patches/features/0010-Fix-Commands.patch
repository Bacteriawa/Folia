     public void saveAllChunks(final boolean flush, final boolean shutdown, final boolean logProgress) {
         // Folia start - region threading
-        this.saveAllChunksRegionised(flush, shutdown, logProgress, true, true, true);
+        if (TickRegionScheduler.getCurrentRegion() != null) {
+            this.saveAllChunksRegionised(flush, shutdown, logProgress, true, true, true);
+        } else {
+            this.saveAllChunksFromGlobal(flush, shutdown, logProgress);
+        }
+    }
+
+    private void saveAllChunksFromGlobal(final boolean flush, final boolean shutdown, final boolean logProgress) {
+        final ThreadedRegionizer<TickRegions.TickRegionData, TickRegions.TickRegionSectionData> regioniser = this.world.regioniser;
+        final java.util.List<int[]> regionChunkCoordinates = new java.util.ArrayList<>();
+        regioniser.computeForAllRegions(region -> {
+            if (region.regioniser.world != this.world) {
+                return;
+            }
+            Long sectionKeyObj = region.getCenterSection();
+            if (sectionKeyObj == null) {
+                final LongArrayList sections = region.getOwnedSections();
+                if (sections.isEmpty()) {
+                    return;
+                }
+                sectionKeyObj = sections.getLong(0);
+            }
+            final long sectionKey = sectionKeyObj.longValue();
+            final int chunkX = CoordinateUtils.getChunkX(sectionKey) << regioniser.sectionChunkShift;
+            final int chunkZ = CoordinateUtils.getChunkZ(sectionKey) << regioniser.sectionChunkShift;
+            regionChunkCoordinates.add(new int[]{chunkX, chunkZ});
+        });
+
+        if (regionChunkCoordinates.isEmpty()) {
+            return;
+        }
+
+        for (int i = 0, size = regionChunkCoordinates.size(); i < size; ++i) {
+            final int[] coords = regionChunkCoordinates.get(i);
+            final boolean first = i == 0;
+            final boolean last = i == size - 1;
+            final java.util.concurrent.CompletableFuture<Void> future = new java.util.concurrent.CompletableFuture<>();
+            RegionizedServer.getInstance().taskQueue.queueChunkTask(this.world, coords[0], coords[1], () -> {
+                try {
+                    this.saveAllChunksRegionised(flush, shutdown, logProgress, first, last, true);
+                    future.complete(null);
+                } catch (Throwable throwable) {
+                    future.completeExceptionally(throwable);
+                }
+            });
+            joinUnchecked(future);
+        }
+    }
+
+    private static void joinUnchecked(final java.util.concurrent.CompletableFuture<?> future) {
+        try {
+            future.join();
+        } catch (final java.util.concurrent.CompletionException exception) {
+            final Throwable cause = exception.getCause();
+            if (cause instanceof RuntimeException runtimeException) {
+                throw runtimeException;
+            }
+            if (cause instanceof Error error) {
+                throw error;
+            }
+            throw new RuntimeException(cause);
+        }
     }
