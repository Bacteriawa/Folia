+    private static Map<ChunkPos, List<BlockPos>> partitionBoundingBox(BoundingBox boundingBox) {
+        Map<ChunkPos, List<BlockPos>> partitions = new LinkedHashMap<>();
+        for (int z = boundingBox.minZ(); z <= boundingBox.maxZ(); z++) {
+            for (int y = boundingBox.minY(); y <= boundingBox.maxY(); y++) {
+                for (int x = boundingBox.minX(); x <= boundingBox.maxX(); x++) {
+                    BlockPos pos = new BlockPos(x, y, z);
+                    partitions.computeIfAbsent(new ChunkPos(pos), cp -> new ArrayList<>()).add(pos);
+                }
+            }
+        }
+        return partitions;
+    }
+
+    private static Map<ChunkPos, List<BlockPos>> groupByChunk(Collection<BlockPos> positions) {
+        return groupByChunkPositions(new ArrayList<>(positions));
+    }
+
+    private static Map<ChunkPos, List<BlockPos>> groupByChunkPositions(Collection<BlockPos> positions) {
+        Map<ChunkPos, List<BlockPos>> partitions = new LinkedHashMap<>();
+        for (BlockPos pos : positions) {
+            partitions.computeIfAbsent(new ChunkPos(pos), cp -> new ArrayList<>()).add(pos);
+        }
+        return partitions;
+    }
+
+    private static Map<ChunkPos, List<CloneCommands.CloneBlockInfo>> groupCloneInfosByChunk(Collection<CloneCommands.CloneBlockInfo> infos) {
+        Map<ChunkPos, List<CloneCommands.CloneBlockInfo>> partitions = new LinkedHashMap<>();
+        for (CloneCommands.CloneBlockInfo info : infos) {
+            partitions.computeIfAbsent(new ChunkPos(info.pos), cp -> new ArrayList<>()).add(info);
+        }
+        return partitions;
+    }
