diff --git a/io/papermc/paper/threadedregions/commands/CommandExecutionBridge.java b/io/papermc/paper/threadedregions/commands/CommandExecutionBridge.java
new file mode 100644
index 0000000000000000000000000000000000000000..adc4b8b8534a039f4e6c0182b3b046c91dea7621
--- /dev/null
+++ b/io/papermc/paper/threadedregions/commands/CommandExecutionBridge.java
@@ -0,0 +1,220 @@
+package io.papermc.paper.threadedregions.commands;
+
+import com.mojang.brigadier.exceptions.CommandSyntaxException;
+import io.papermc.paper.threadedregions.RegionizedServer;
+import net.minecraft.core.BlockPos;
+import net.minecraft.server.level.ServerLevel;
+import net.minecraft.world.entity.Entity;
+import net.minecraft.world.level.ChunkPos;
+import org.bukkit.Bukkit;
+
+import java.util.ArrayList;
+import java.util.Collection;
+import java.util.LinkedHashSet;
+import java.util.List;
+import java.util.concurrent.CompletableFuture;
+import java.util.concurrent.CompletionException;
+
+/**
+ * Utility helpers for executing vanilla command logic on the correct threading context.
+ * Many commands manipulate world or global data structures that are owned by a specific thread in Folia.
+ * These helpers synchronously bridge the execution to the appropriate thread while keeping the vanilla
+ * command contract of returning an integer result or throwing a {@link CommandSyntaxException}.
+ */
+public final class CommandExecutionBridge {
+
+    private CommandExecutionBridge() {
+    }
+
+    @FunctionalInterface
+    public interface CommandRunnable {
+        void run() throws CommandSyntaxException;
+    }
+
+    @FunctionalInterface
+    public interface CommandSupplier<T> {
+        T run() throws CommandSyntaxException;
+    }
+
+    @FunctionalInterface
+    public interface EntityCommandSupplier<E extends Entity, T> {
+        T run(E entity) throws CommandSyntaxException;
+    }
+
+    @FunctionalInterface
+    public interface EntityCommandRunnable<E extends Entity> {
+        void run(E entity) throws CommandSyntaxException;
+    }
+
+    @FunctionalInterface
+    public interface ChunkCommandRunnable {
+        void run(ServerLevel level, ChunkPos chunkPos) throws CommandSyntaxException;
+    }
+
+    @FunctionalInterface
+    public interface ChunkCommandSupplier<T> {
+        T run(ServerLevel level, ChunkPos chunkPos) throws CommandSyntaxException;
+    }
+
+    public static void runOnGlobal(CommandRunnable runnable) throws CommandSyntaxException {
+        callOnGlobal(() -> {
+            runnable.run();
+            return null;
+        });
+    }
+
+    public static <T> T callOnGlobal(CommandSupplier<T> supplier) throws CommandSyntaxException {
+        if (RegionizedServer.isGlobalTickThread()) {
+            return supplier.run();
+        }
+        CompletableFuture<T> future = new CompletableFuture<>();
+        RegionizedServer.getInstance().addTask(() -> {
+            try {
+                future.complete(supplier.run());
+            } catch (Throwable throwable) {
+                future.completeExceptionally(throwable);
+            }
+        });
+        return join(future);
+    }
+
+    public static void runOnRegion(ServerLevel level, BlockPos blockPos, CommandRunnable runnable) throws CommandSyntaxException {
+        callOnRegion(level, blockPos, () -> {
+            runnable.run();
+            return null;
+        });
+    }
+
+    public static <T> T callOnRegion(ServerLevel level, BlockPos blockPos, CommandSupplier<T> supplier) throws CommandSyntaxException {
+        return callOnRegion(level, new ChunkPos(blockPos), supplier);
+    }
+
+    public static void runOnRegion(ServerLevel level, ChunkPos chunkPos, CommandRunnable runnable) throws CommandSyntaxException {
+        callOnRegion(level, chunkPos, () -> {
+            runnable.run();
+            return null;
+        });
+    }
+
+    public static <T> T callOnRegion(ServerLevel level, ChunkPos chunkPos, CommandSupplier<T> supplier) throws CommandSyntaxException {
+        if (ownsChunk(level, chunkPos)) {
+            return supplier.run();
+        }
+        CompletableFuture<T> future = new CompletableFuture<>();
+        RegionizedServer.getInstance().taskQueue.queueTickTaskQueue(level, chunkPos.x, chunkPos.z, () -> {
+            try {
+                future.complete(supplier.run());
+            } catch (Throwable throwable) {
+                future.completeExceptionally(throwable);
+            }
+        });
+        return join(future);
+    }
+
+    public static <E extends Entity> void runOnEntity(E entity, EntityCommandRunnable<E> runnable) throws CommandSyntaxException {
+        callOnEntity(entity, e -> {
+            runnable.run(e);
+            return null;
+        });
+    }
+
+    public static <E extends Entity, T> T callOnEntity(E entity, EntityCommandSupplier<E, T> supplier) throws CommandSyntaxException {
+        ServerLevel level = (ServerLevel) entity.level();
+        ChunkPos chunkPos = entity.chunkPosition();
+        if (ownsChunk(level, chunkPos)) {
+            return supplier.run(entity);
+        }
+        CompletableFuture<T> future = new CompletableFuture<>();
+        boolean scheduled = entity.getBukkitEntity().taskScheduler.schedule(
+            scheduledEntity -> {
+                try {
+                    @SuppressWarnings("unchecked")
+                    E casted = (E) scheduledEntity;
+                    future.complete(supplier.run(casted));
+                } catch (Throwable throwable) {
+                    future.completeExceptionally(throwable);
+                }
+            },
+            retired -> future.completeExceptionally(new IllegalStateException("entity retired while executing command task")),
+            1L
+        );
+        if (!scheduled) {
+            future.completeExceptionally(new IllegalStateException("failed to schedule command task for entity"));
+        }
+        return join(future);
+    }
+
+    public static void runOnChunks(ServerLevel level, Collection<ChunkPos> chunkPositions, ChunkCommandRunnable runnable) throws CommandSyntaxException {
+        for (ChunkPos chunkPos : uniqueChunkPositions(chunkPositions)) {
+            ChunkPos immutable = chunkPos;
+            runOnRegion(level, immutable, () -> runnable.run(level, immutable));
+        }
+    }
+
+    public static <T> List<T> callOnChunks(ServerLevel level, Collection<ChunkPos> chunkPositions, ChunkCommandSupplier<T> supplier) throws CommandSyntaxException {
+        List<T> results = new ArrayList<>();
+        for (ChunkPos chunkPos : uniqueChunkPositions(chunkPositions)) {
+            ChunkPos immutable = chunkPos;
+            T result = callOnRegion(level, immutable, () -> supplier.run(level, immutable));
+            if (result != null) {
+                results.add(result);
+            }
+        }
+        return results;
+    }
+
+    public static void runOnChunkBox(ServerLevel level, BlockPos min, BlockPos max, ChunkCommandRunnable runnable) throws CommandSyntaxException {
+        runOnChunks(level, chunkRange(min, max), runnable);
+    }
+
+    public static <T> List<T> callOnChunkBox(ServerLevel level, BlockPos min, BlockPos max, ChunkCommandSupplier<T> supplier) throws CommandSyntaxException {
+        return callOnChunks(level, chunkRange(min, max), supplier);
+    }
+
+    private static boolean ownsChunk(ServerLevel level, ChunkPos chunkPos) {
+        return Bukkit.isOwnedByCurrentRegion(level.getWorld(), chunkPos.x, chunkPos.z);
+    }
+
+    private static <T> T join(CompletableFuture<T> future) throws CommandSyntaxException {
+        try {
+            return future.join();
+        } catch (CompletionException exception) {
+            Throwable cause = exception.getCause();
+            return rethrow(cause == null ? exception : cause);
+        }
+    }
+
+    private static <T> T rethrow(Throwable throwable) throws CommandSyntaxException {
+        if (throwable instanceof CommandSyntaxException commandSyntaxException) {
+            throw commandSyntaxException;
+        }
+        if (throwable instanceof RuntimeException runtimeException) {
+            throw runtimeException;
+        }
+        if (throwable instanceof Error error) {
+            throw error;
+        }
+        throw new RuntimeException(throwable);
+    }
+
+    private static Collection<ChunkPos> uniqueChunkPositions(Collection<ChunkPos> positions) {
+        if (positions instanceof LinkedHashSet<ChunkPos> linkedHashSet) {
+            return linkedHashSet;
+        }
+        return new LinkedHashSet<>(positions);
+    }
+
+    private static Collection<ChunkPos> chunkRange(BlockPos min, BlockPos max) {
+        int minChunkX = Math.min(min.getX() >> 4, max.getX() >> 4);
+        int maxChunkX = Math.max(min.getX() >> 4, max.getX() >> 4);
+        int minChunkZ = Math.min(min.getZ() >> 4, max.getZ() >> 4);
+        int maxChunkZ = Math.max(min.getZ() >> 4, max.getZ() >> 4);
+        Collection<ChunkPos> chunks = new LinkedHashSet<>();
+        for (int chunkX = minChunkX; chunkX <= maxChunkX; ++chunkX) {
+            for (int chunkZ = minChunkZ; chunkZ <= maxChunkZ; ++chunkZ) {
+                chunks.add(new ChunkPos(chunkX, chunkZ));
+            }
+        }
+        return chunks;
+    }
+}
