+    private static Map<ChunkPos, List<BlockPos>> partitionBoundingBox(BoundingBox boundingBox) {
+        Map<ChunkPos, List<BlockPos>> partitions = new LinkedHashMap<>();
+        for (int z = boundingBox.minZ(); z <= boundingBox.maxZ(); z++) {
+            for (int y = boundingBox.minY(); y <= boundingBox.maxY(); y++) {
+                for (int x = boundingBox.minX(); x <= boundingBox.maxX(); x++) {
+                    BlockPos pos = new BlockPos(x, y, z);
+                    partitions.computeIfAbsent(new ChunkPos(pos), cp -> new ArrayList<>()).add(pos);
+                }
+            }
+        }
+        return partitions;
+    }
