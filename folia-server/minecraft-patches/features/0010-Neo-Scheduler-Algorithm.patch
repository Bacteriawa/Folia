+        public long startTime() {
+            return this.startTime;
+        }
+
+        public long waitTime() {
+            return this.waitTime;
+        }
+
+        public double weight() {
+            return this.weight;
+        }
+
+        private void markStarted(final long startTime, final long waitTime) {
+            this.startTime = startTime;
+            this.waitTime = waitTime;
+        }
+    }
+
+    private static final class CategoryStats {
+        private final LongAdder waitTotal = new LongAdder();
+        private final LongAdder execTotal = new LongAdder();
+        private final LongAdder completed = new LongAdder();
+        private final LongAdder pending = new LongAdder();
+        private final AtomicLong lastAlert = new AtomicLong();
+
+        void tryPublishAlert(final TaskCategory category, final long id, final long waitedNanos,
+                             final ConcurrentLinkedQueue<FairnessAlert> queue) {
+            final long now = System.nanoTime();
+            final long previous = this.lastAlert.get();
+            if ((now - previous) < ALERT_COOLDOWN_NS) {
+                return;
+            }
+            if (this.lastAlert.compareAndSet(previous, now)) {
+                queue.add(new FairnessAlert(category, id, waitedNanos));
+            }
+        }
+    }
+}
