@@ -0,0 +1,31 @@
+package io.papermc.paper.threadedregions.scheduler.policy;
+
+/**
+ * Identifies the major task classes the Folia scheduler is aware of.
+ * Categories are intentionally coarse grained so that multiple layers
+ * (region ticks, entity schedulers, global schedulers, IO helpers, etc)
+ * can share a uniform set of fairness and monitoring utilities.
+ */
+public enum TaskCategory {
+
+    REGION(3, true),
+    ENTITY(2, true),
+    GLOBAL(1, false),
+    IO(4, true);
+
+    private final int importance;
+    private final boolean regionLocal;
+
+    TaskCategory(final int importance, final boolean regionLocal) {
+        this.importance = importance;
+        this.regionLocal = regionLocal;
+    }
+
+    public int importance() {
+        return this.importance;
+    }
+
+    public boolean isRegionLocal() {
+        return this.regionLocal;
+    }
+}
