+package io.papermc.paper.threadedregions.scheduler.queue;
+
+import org.jctools.queues.MpscUnboundedArrayQueue;
+
+/**
+ * Small wrapper around JCTools' lock-free MPSC queue so callers do not need to depend on the
+ * third-party API directly. This queue is unbounded and optimized for scenarios where many
+ * producer threads enqueue short tasks that a single region scheduler thread drains.
+ */
+public final class LockFreeTaskQueue<T> {
+
+    private final MpscUnboundedArrayQueue<T> queue;
+
+    public LockFreeTaskQueue(final int initialChunkSize) {
+        // MpscUnboundedArrayQueue requires the chunk size to be a power of two >= 2
+        final int normalizedSize = Math.max(4, Integer.highestOneBit(initialChunkSize - 1) << 1);
+        this.queue = new MpscUnboundedArrayQueue<>(normalizedSize);
+    }
+
+    public void add(final T value) {
+        if (value == null) {
+            throw new NullPointerException("value");
+        }
+        // The queue is unbounded, but offer can still return false while resizing; spin briefly.
+        while (!this.queue.offer(value)) {
+            Thread.onSpinWait();
+        }
+    }
+
+    public T poll() {
+        return this.queue.poll();
+    }
+
+    public boolean isEmpty() {
+        return this.queue.isEmpty();
+    }
+}
