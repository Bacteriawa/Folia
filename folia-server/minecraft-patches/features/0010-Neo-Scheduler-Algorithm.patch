index 0000000000000000000000000000000000000000..d5cf3f20e1846a93065224d0b458b606103a8f2b
--- /dev/null
+++ b/io/papermc/paper/threadedregions/RegionLoadBalancer.java
@@ -0,0 +1,53 @@
+package io.papermc.paper.threadedregions;
+
+import java.util.Collection;
+
+/**
+ * Maintains lightweight weights that the fairness monitor uses to bias
+ * scheduling decisions. Rebalancing is only triggered during region
+ * split/merge events to honor the restriction on moving running tasks.
+ */
+public final class RegionLoadBalancer {
+
+    private static final RegionLoadBalancer INSTANCE = new RegionLoadBalancer();
+
+    private RegionLoadBalancer() {}
+
+    public static RegionLoadBalancer get() {
+        return INSTANCE;
+    }
+
+    public double computeWeight(final TickRegions.TickRegionData data) {
+        final TickRegions.RegionStats stats = data.getRegionStats();
+        final double chunks = Math.max(1, stats.getChunkCount());
+        final double entities = Math.max(1, stats.getEntityCount());
+        final double players = Math.max(1, stats.getPlayerCount());
+        return 1.0D + (chunks * 0.01D) + (entities * 0.05D) + (players * 0.35D);
+    }
+
+    public void applyWeight(final TickRegions.TickRegionData data) {
+        final double weight = this.computeWeight(data);
+        data.getRegionSchedulingHandle().setFairnessWeight(weight);
+    }
+
+    public void onSplit(final TickRegions.TickRegionData parent,
+                        final Collection<TickRegions.TickRegionData> children) {
+        if (children.isEmpty()) {
+            return;
+        }
+        double demand = 0.0D;
+        for (final TickRegions.TickRegionData child : children) {
+            demand += this.computeWeight(child);
+        }
+        demand = Math.max(1.0D, demand);
+        final double parentWeight = parent.getRegionSchedulingHandle().getFairnessWeight();
+        for (final TickRegions.TickRegionData child : children) {
+            final double ratio = this.computeWeight(child) / demand;
+            child.getRegionSchedulingHandle().setFairnessWeight(Math.max(0.25D, parentWeight * ratio));
+        }
+    }
+
+    public void onMerge(final TickRegions.TickRegionData into) {
+        this.applyWeight(into);
+    }
+}
