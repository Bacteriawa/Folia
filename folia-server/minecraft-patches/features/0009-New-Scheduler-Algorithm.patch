+    }
+
+    public void notifyStarvation(final long regionId, final long observedWaitNanoseconds) {
+        this.fairnessScoreboard.recordStarvationWarning(regionId);
+        this.fairnessAlerts.add(new FairnessAlert(regionId, observedWaitNanoseconds, System.nanoTime()));
+    }
+
+    public SchedulerMetricsSnapshot snapshot() {
+        final long now = System.nanoTime();
+        this.lastSnapshotTime.set(now);
+        final Map<Long, FairnessScoreboard.FairnessSnapshot> fairnessSnapshots = this.fairnessScoreboard.snapshotAllRegions();
+        final Map<TaskType, TaskLatencyTracker.LatencyMetrics> latencySnapshots = this.latencyTracker.snapshotAll();
+        final EnumMap<TaskType, FairnessScoreboard.TypeSnapshot> typeSnapshots = new EnumMap<>(TaskType.class);
+        for (final TaskType taskType : TaskType.values()) {
+            typeSnapshots.put(taskType, this.fairnessScoreboard.snapshot(taskType));
+        }
+        return new SchedulerMetricsSnapshot(now, Instant.now(), fairnessSnapshots, latencySnapshots, typeSnapshots);
+    }
+
+    public List<FairnessAlert> drainFairnessAlerts() {
+        final List<FairnessAlert> drained = new ArrayList<>();
+        for (FairnessAlert alert; (alert = this.fairnessAlerts.poll()) != null;) {
+            drained.add(alert);
+        }
+        return drained;
+    }
+
+    public long getLastSnapshotTime() {
+        return this.lastSnapshotTime.get();
+    }
+
+    public record SchedulerMetricsSnapshot(long snapshotNanoTime,
+                                           Instant snapshotInstant,
+                                           Map<Long, FairnessScoreboard.FairnessSnapshot> regionFairness,
+                                           Map<TaskType, TaskLatencyTracker.LatencyMetrics> latencyMetrics,
+                                           Map<TaskType, FairnessScoreboard.TypeSnapshot> typeFairness) {}
+
+    public record FairnessAlert(long regionId, long observedWaitNanoseconds, long createdNanoTime) {}
+}
