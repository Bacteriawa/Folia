+package io.papermc.paper.threadedregions.scheduling;
+
+import io.papermc.paper.threadedregions.monitoring.FairnessMonitor;
+import io.papermc.paper.threadedregions.monitoring.SchedulerMetricsCollector;
+
+import java.util.concurrent.TimeUnit;
+
+public final class SchedulingServices {
+
+    private static final SchedulingServices INSTANCE = new SchedulingServices();
+
+    private final TaskLatencyTracker latencyTracker = new TaskLatencyTracker();
+    private final FairnessScoreboard fairnessScoreboard = new FairnessScoreboard();
+    private final SchedulerMetricsCollector metricsCollector = new SchedulerMetricsCollector(this.fairnessScoreboard, this.latencyTracker);
+    private final FairnessMonitor fairnessMonitor = new FairnessMonitor(this.metricsCollector, TimeUnit.MILLISECONDS.toNanos(200L), 3);
+    private final AdaptiveLoadBalancer adaptiveLoadBalancer = new AdaptiveLoadBalancer(this);
+    private final UrgentTaskCoordinator urgentTaskCoordinator = new UrgentTaskCoordinator(this);
+
+    private SchedulingServices() {}
+
+    public static SchedulingServices get() {
+        return INSTANCE;
+    }
+
+    public TaskLatencyTracker getLatencyTracker() {
+        return this.latencyTracker;
+    }
+
+    public FairnessScoreboard getFairnessScoreboard() {
+        return this.fairnessScoreboard;
+    }
+
+    public SchedulerMetricsCollector getMetricsCollector() {
+        return this.metricsCollector;
+    }
+
+    public FairnessMonitor getFairnessMonitor() {
+        return this.fairnessMonitor;
+    }
+
+    public AdaptiveLoadBalancer getAdaptiveLoadBalancer() {
+        return this.adaptiveLoadBalancer;
+    }
+
+    public UrgentTaskCoordinator getUrgentTaskCoordinator() {
+        return this.urgentTaskCoordinator;
+    }
+}
