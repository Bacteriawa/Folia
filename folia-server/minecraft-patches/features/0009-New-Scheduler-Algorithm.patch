diff --git a/io/papermc/paper/threadedregions/scheduling/AdaptiveLoadBalancer.java b/io/papermc/paper/threadedregions/scheduling/AdaptiveLoadBalancer.java
new file mode 100644
index 0000000000000000000000000000000000000000..60a2ab9b565ab1f7252a298744cbaa853d6fba9a
--- /dev/null
+++ b/io/papermc/paper/threadedregions/scheduling/AdaptiveLoadBalancer.java
@@ -0,0 +1,208 @@
+package io.papermc.paper.threadedregions.scheduling;
+
+import io.papermc.paper.threadedregions.TickRegionScheduler;
+import io.papermc.paper.threadedregions.TickRegions;
+import io.papermc.paper.threadedregions.monitoring.FairnessMonitor;
+import io.papermc.paper.threadedregions.monitoring.SchedulerMetricsCollector;
+import java.util.List;
+import java.util.concurrent.TimeUnit;
+import java.util.concurrent.atomic.AtomicLong;
+
+public final class AdaptiveLoadBalancer {
+
+    private final SchedulingServices services;
+    
+    private volatile long systemLoadThreshold = TimeUnit.MILLISECONDS.toNanos(50L);
+    private volatile double highLoadFairnessMultiplier = 1.5;
+    private volatile double lowLoadFairnessMultiplier = 0.75;
+    private final AtomicLong lastLoadAssessment = new AtomicLong();
+
+    AdaptiveLoadBalancer(final SchedulingServices services) {
+        this.services = services;
+    }
+    
+    public void assessSystemLoad() {
+        final long now = System.nanoTime();
+        final long lastAssessment = this.lastLoadAssessment.get();
+        
+        if (now - lastAssessment < TimeUnit.SECONDS.toNanos(5L)) {
+            return;
+        }
+        
+        if (!this.lastLoadAssessment.compareAndSet(lastAssessment, now)) {
+            return;
+        }
+        
+        try {
+            if (this.services == null || this.services.getMetricsCollector() == null) {
+                return;
+            }
+            
+            final SchedulerMetricsCollector.SchedulerMetricsSnapshot snapshot = this.services.getMetricsCollector().snapshot();
+            if (snapshot == null || snapshot.latencyMetrics() == null) {
+                return;
+            }
+            
+            long totalWait = 0L;
+            long totalExecutions = 0L;
+            for (final var latencyMetrics : snapshot.latencyMetrics().values()) {
+                if (latencyMetrics != null && latencyMetrics.taskCount() > 0L) {
+                    final double avgWait = latencyMetrics.averageWait();
+                    final long count = latencyMetrics.taskCount();
+                    if (avgWait >= 0D && avgWait <= Long.MAX_VALUE && count > 0L) {
+                        final long waitContribution = (long)(avgWait * count);
+                        if (waitContribution >= 0L && totalWait <= Long.MAX_VALUE - waitContribution) {
+                            totalWait += waitContribution;
+                            totalExecutions += count;
+                        }
+                    }
+                }
+            }
+            
+            if (totalExecutions <= 0L) {
+                return;
+            }
+            
+            final double averageWait = (double)totalWait / (double)totalExecutions;
+            if (!Double.isFinite(averageWait) || averageWait < 0D) {
+                return;
+            }
+            
+            synchronized (this) {
+                if (averageWait > this.systemLoadThreshold) {
+                    this.highLoadFairnessMultiplier = Math.min(2.0, Math.max(1.0, this.highLoadFairnessMultiplier * 1.1));
+                    this.lowLoadFairnessMultiplier = Math.max(0.5, Math.min(1.0, this.lowLoadFairnessMultiplier * 0.95));
+                } else {
+                    this.highLoadFairnessMultiplier = Math.max(1.0, Math.min(2.0, this.highLoadFairnessMultiplier * 0.95));
+                    this.lowLoadFairnessMultiplier = Math.min(1.0, Math.max(0.5, this.lowLoadFairnessMultiplier * 1.05));
+                }
+            }
+        } catch (final Throwable throwable) {
+            // Load assessment failure should not break scheduling
+        }
+    }
+
+    public void onRegionSplit(final TickRegions.TickRegionData parent,
+                              final List<TickRegions.TickRegionData> children) {
+        if (children == null || children.isEmpty()) {
+            return;
+        }
+
+        this.assessSystemLoad();
+
+        final FairnessScoreboard.FairnessSnapshot parentFairness = this.services.getFairnessScoreboard().snapshot(parent.id);
+        final FairnessMonitor.RegionState parentState = this.services.getFairnessMonitor().snapshotRegion(parent.id);
+
+        long candidateDebt = parent.getFairnessDebt();
+        candidateDebt = Math.max(candidateDebt, parentFairness.lastObservedWait());
+        candidateDebt = Math.max(candidateDebt, (long)parentFairness.averageWait());
+        candidateDebt = Math.max(candidateDebt, parentState.lastObservedWait());
+
+        if (parentState.consecutiveBreaches() > 0) {
+            candidateDebt = Math.max(candidateDebt, (long)(TickRegionScheduler.TIME_BETWEEN_TICKS / 2L * this.highLoadFairnessMultiplier));
+        } else {
+            final double multiplier = this.getSystemLoadMultiplier();
+            candidateDebt = (long)(candidateDebt * multiplier);
+        }
+
+        if (candidateDebt <= 0L) {
+            this.services.getFairnessMonitor().resetRegion(parent.id);
+            this.services.getFairnessScoreboard().clearRegion(parent.id);
+            return;
+        }
+
+        candidateDebt = Math.min(candidateDebt, TickRegionScheduler.TIME_BETWEEN_TICKS);
+        final int childCount = children.size();
+        if (childCount <= 0) {
+            return;
+        }
+        
+        final long perChildDebt = Math.max(1L, (long)(candidateDebt / childCount * this.getSystemLoadMultiplier()));
+
+        for (final TickRegions.TickRegionData child : children) {
+            child.setFairnessDebt(perChildDebt);
+            this.services.getFairnessMonitor().resetRegion(child.id);
+            this.services.getFairnessScoreboard().clearRegion(child.id);
+        }
+
+        this.services.getFairnessMonitor().resetRegion(parent.id);
+        this.services.getFairnessScoreboard().clearRegion(parent.id);
+    }
+
+    public void onRegionMerge(final TickRegions.TickRegionData from,
+                              final TickRegions.TickRegionData into) {
+        this.assessSystemLoad();
+
+        final FairnessScoreboard.FairnessSnapshot fromFairness = this.services.getFairnessScoreboard().snapshot(from.id);
+        final FairnessMonitor.RegionState fromState = this.services.getFairnessMonitor().snapshotRegion(from.id);
+
+        long candidateDebt = into.getFairnessDebt();
+        candidateDebt = Math.max(candidateDebt, fromFairness.lastObservedWait());
+        candidateDebt = Math.max(candidateDebt, (long)fromFairness.averageWait());
+        candidateDebt = Math.max(candidateDebt, fromState.lastObservedWait());
+
+        if (fromState.consecutiveBreaches() > 0) {
+            candidateDebt = Math.max(candidateDebt, (long)(TickRegionScheduler.TIME_BETWEEN_TICKS / 3L * this.highLoadFairnessMultiplier));
+        } else {
+            final double multiplier = this.getSystemLoadMultiplier();
+            candidateDebt = (long)(candidateDebt * multiplier);
+        }
+
+        if (candidateDebt > 0L) {
+            into.setFairnessDebt(Math.min(candidateDebt, TickRegionScheduler.TIME_BETWEEN_TICKS));
+        }
+
+        this.services.getFairnessMonitor().resetRegion(from.id);
+        this.services.getFairnessScoreboard().clearRegion(from.id);
+    }
+    
+    private double getSystemLoadMultiplier() {
+        try {
+            if (this.services == null || this.services.getMetricsCollector() == null) {
+                return 1.0;
+            }
+            
+            final SchedulerMetricsCollector.SchedulerMetricsSnapshot snapshot = this.services.getMetricsCollector().snapshot();
+            if (snapshot == null || snapshot.latencyMetrics() == null) {
+                return 1.0;
+            }
+            
+            long totalWait = 0L;
+            long totalExecutions = 0L;
+            for (final var latencyMetrics : snapshot.latencyMetrics().values()) {
+                if (latencyMetrics != null && latencyMetrics.taskCount() > 0L) {
+                    final double avgWait = latencyMetrics.averageWait();
+                    final long count = latencyMetrics.taskCount();
+                    if (avgWait >= 0D && avgWait <= Long.MAX_VALUE && count > 0L) {
+                        final long waitContribution = (long)(avgWait * count);
+                        if (waitContribution >= 0L && totalWait <= Long.MAX_VALUE - waitContribution) {
+                            totalWait += waitContribution;
+                            totalExecutions += count;
+                        }
+                    }
+                }
+            }
+            
+            if (totalExecutions <= 0L) {
+                return 1.0;
+            }
+            
+            final double averageWait = (double)totalWait / (double)totalExecutions;
+            if (!Double.isFinite(averageWait) || averageWait < 0D) {
+                return 1.0;
+            }
+            
+            final double highMultiplier = this.highLoadFairnessMultiplier;
+            final double lowMultiplier = this.lowLoadFairnessMultiplier;
+            
+            if (averageWait > this.systemLoadThreshold) {
+                return Math.max(1.0, Math.min(2.0, highMultiplier));
+            } else {
+                return Math.max(0.5, Math.min(1.0, lowMultiplier));
+            }
+        } catch (final Throwable throwable) {
+            return 1.0;
+        }
+    }
+}
+
diff --git a/io/papermc/paper/threadedregions/scheduling/FairnessScoreboard.java b/io/papermc/paper/threadedregions/scheduling/FairnessScoreboard.java
new file mode 100644
index 0000000000000000000000000000000000000000..f28bf21412a2f8fc43b73d5dd6be780727c85d58
--- /dev/null
+++ b/io/papermc/paper/threadedregions/scheduling/FairnessScoreboard.java
@@ -0,0 +1,149 @@
+package io.papermc.paper.threadedregions.scheduling;
+
+import java.util.EnumMap;
+import java.util.Map;
+import java.util.Objects;
+import java.util.concurrent.ConcurrentHashMap;
+import java.util.concurrent.ConcurrentMap;
+import java.util.concurrent.atomic.AtomicLong;
+import java.util.concurrent.atomic.LongAdder;
+
+public final class FairnessScoreboard {
+
+    private final ConcurrentMap<Long, FairnessStat> regionStats = new ConcurrentHashMap<>();
+    private final EnumMap<TaskType, TypeAccumulator> typeAccumulators = new EnumMap<>(TaskType.class);
+
+    public FairnessScoreboard() {
+        for (final TaskType type : TaskType.values()) {
+            this.typeAccumulators.put(type, new TypeAccumulator());
+        }
+    }
+
+    public void recordExecution(final long regionId, final TaskType type, final long waitNanoseconds) {
+        Objects.requireNonNull(type, "type");
+        final long now = System.nanoTime();
+        final long sanitizedWait = Math.max(waitNanoseconds, 0L);
+
+        if (type.isRegionBound()) {
+            final FairnessStat stat = this.regionStats.computeIfAbsent(regionId, FairnessStat::new);
+            stat.executions.increment();
+            stat.totalWait.add(sanitizedWait);
+            stat.maxWait.accumulateAndGet(sanitizedWait, Math::max);
+            stat.lastExecutionTime.set(now);
+            stat.lastObservedWait.set(sanitizedWait);
+        }
+
+        final TypeAccumulator accumulator = this.typeAccumulators.get(type);
+        if (accumulator != null) {
+            accumulator.executions.increment();
+            accumulator.totalWait.add(sanitizedWait);
+            accumulator.maxWait.accumulateAndGet(sanitizedWait, Math::max);
+            accumulator.lastExecutionTime.set(now);
+        }
+    }
+
+    public void recordStarvationWarning(final long regionId) {
+        final FairnessStat stat = this.regionStats.computeIfAbsent(regionId, FairnessStat::new);
+        stat.starvationWarnings.increment();
+        stat.lastStarvationTime.set(System.nanoTime());
+    }
+
+    public FairnessSnapshot snapshot(final long regionId) {
+        final FairnessStat stat = this.regionStats.get(regionId);
+        if (stat == null) {
+            return FairnessSnapshot.EMPTY;
+        }
+        return stat.snapshot();
+    }
+
+    public Map<Long, FairnessSnapshot> snapshotAllRegions() {
+        final ConcurrentHashMap<Long, FairnessSnapshot> snapshot = new ConcurrentHashMap<>(this.regionStats.size());
+        this.regionStats.forEach((id, stat) -> snapshot.put(id, stat.snapshot()));
+        return snapshot;
+    }
+
+    public void clearRegion(final long regionId) {
+        this.regionStats.remove(regionId);
+    }
+
+    public TypeSnapshot snapshot(final TaskType type) {
+        final TypeAccumulator accumulator = this.typeAccumulators.get(type);
+        return accumulator == null ? TypeSnapshot.EMPTY : accumulator.snapshot();
+    }
+
+    public Map<TaskType, TypeSnapshot> snapshotAllTypes() {
+        final EnumMap<TaskType, TypeSnapshot> snapshot = new EnumMap<>(TaskType.class);
+        for (final Map.Entry<TaskType, TypeAccumulator> entry : this.typeAccumulators.entrySet()) {
+            snapshot.put(entry.getKey(), entry.getValue().snapshot());
+        }
+        return snapshot;
+    }
+
+    private static final class FairnessStat {
+
+        private final long regionId;
+        private final LongAdder executions = new LongAdder();
+        private final LongAdder totalWait = new LongAdder();
+        private final LongAdder starvationWarnings = new LongAdder();
+        private final AtomicLong maxWait = new AtomicLong();
+        private final AtomicLong lastExecutionTime = new AtomicLong();
+        private final AtomicLong lastObservedWait = new AtomicLong();
+        private final AtomicLong lastStarvationTime = new AtomicLong();
+
+        private FairnessStat(final long regionId) {
+            this.regionId = regionId;
+        }
+
+        private FairnessSnapshot snapshot() {
+            final long count = this.executions.sum();
+            final long total = this.totalWait.sum();
+            final double average = count == 0L ? 0D : (double)total / (double)count;
+            return new FairnessSnapshot(
+                this.regionId,
+                count,
+                average,
+                this.maxWait.get(),
+                this.lastExecutionTime.get(),
+                this.lastObservedWait.get(),
+                this.starvationWarnings.sum(),
+                this.lastStarvationTime.get()
+            );
+        }
+    }
+
+    private static final class TypeAccumulator {
+
+        private final LongAdder executions = new LongAdder();
+        private final LongAdder totalWait = new LongAdder();
+        private final AtomicLong maxWait = new AtomicLong();
+        private final AtomicLong lastExecutionTime = new AtomicLong();
+
+        private TypeSnapshot snapshot() {
+            final long count = this.executions.sum();
+            final long total = this.totalWait.sum();
+            final double average = count == 0L ? 0D : (double)total / (double)count;
+            return new TypeSnapshot(count, average, this.maxWait.get(), this.lastExecutionTime.get());
+        }
+    }
+
+    public record FairnessSnapshot(long regionId,
+                                   long executions,
+                                   double averageWait,
+                                   long maxWait,
+                                   long lastExecutionTime,
+                                   long lastObservedWait,
+                                   long starvationWarnings,
+                                   long lastStarvationTime) {
+
+        public static final FairnessSnapshot EMPTY = new FairnessSnapshot(-1L, 0L, 0D, 0L, 0L, 0L, 0L, 0L);
+    }
+
+    public record TypeSnapshot(long executions,
+                               double averageWait,
+                               long maxWait,
+                               long lastExecutionTime) {
+
+        public static final TypeSnapshot EMPTY = new TypeSnapshot(0L, 0D, 0L, 0L);
+    }
+}
+
