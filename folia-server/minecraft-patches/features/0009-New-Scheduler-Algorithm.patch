+++ b/io/papermc/paper/threadedregions/scheduler/policy/IoPriorityManager.java
@@ -0,0 +1,46 @@
+package io.papermc.paper.threadedregions.scheduler.policy;
+
+import it.unimi.dsi.fastutil.longs.Long2IntOpenHashMap;
+/**
+ * Tracks chunk/IO backlog per region and exposes coarse hints so that
+ * the region task queue can adaptively prioritise IO without breaking
+ * isolation guarantees.
+ */
+public final class IoPriorityManager {
+
+    private static final int FORCE_THRESHOLD = 12;
+    private static final int PREFER_THRESHOLD = 4;
+
+    private final Object lock = new Object();
+    private final Long2IntOpenHashMap backlog = new Long2IntOpenHashMap();
+
+    public IoPriorityManager() {
+        this.backlog.defaultReturnValue(0);
+    }
+
+    public IoHint evaluate(final long regionId, final int localBacklog, final int globalBacklog) {
+        final int combined = Math.max(0, localBacklog) + Math.max(0, globalBacklog);
+        synchronized (this.lock) {
+            this.backlog.put(regionId, combined);
+        }
+        if (combined >= FORCE_THRESHOLD) {
+            return IoHint.FORCE_IO;
+        }
+        if (combined >= PREFER_THRESHOLD) {
+            return IoHint.PREFER_IO;
+        }
+        return IoHint.BALANCED;
+    }
+
+    public void clear(final long regionId) {
+        synchronized (this.lock) {
+            this.backlog.remove(regionId);
+        }
+    }
+
+    public enum IoHint {
+        FORCE_IO,
+        PREFER_IO,
+        BALANCED
+    }
+}
diff --git a/io/papermc/paper/threadedregions/scheduler/policy/SchedulerFairnessMonitor.java b/io/papermc/paper/threadedregions/scheduler/policy/SchedulerFairnessMonitor.java
new file mode 100644
index 0000000000000000000000000000000000000000..fa76b37af9b8ff78e745843dae7c04089e96e45f
--- /dev/null
+++ b/io/papermc/paper/threadedregions/scheduler/policy/SchedulerFairnessMonitor.java
@@ -0,0 +1,264 @@
+package io.papermc.paper.threadedregions.scheduler.policy;
+
+import it.unimi.dsi.fastutil.longs.Long2DoubleOpenHashMap;
+import it.unimi.dsi.fastutil.longs.Long2DoubleMap;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.EnumMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Objects;
+import java.util.concurrent.ConcurrentLinkedQueue;
+import java.util.concurrent.TimeUnit;
+import java.util.concurrent.atomic.AtomicLong;
+import java.util.concurrent.atomic.AtomicReference;
+import java.util.concurrent.atomic.LongAdder;
+
+/**
+ * Centralises the fairness policy, starvation detection and lightweight performance
+ * measurements that every scheduler entry point (regions, entities, globals, IO helpers)
+ * depends on. The monitor is intentionally allocation friendly so that it can be invoked
+ * from hot tick paths.
+ */
+public final class SchedulerFairnessMonitor {
+
+    private static final long IDEAL_TICK_BUDGET_NS = TimeUnit.SECONDS.toNanos(1L) / 20L;
+    private static final long STARVATION_THRESHOLD_NS = TimeUnit.SECONDS.toNanos(5L);
+    private static final long ALERT_COOLDOWN_NS = TimeUnit.SECONDS.toNanos(10L);
+    private static final long LOAD_SMOOTHING = 8L;
+
+    private final EnumMap<TaskCategory, CategoryStats> stats = new EnumMap<>(TaskCategory.class);
+    private final EnumMap<TaskCategory, Long2DoubleMap> weights = new EnumMap<>(TaskCategory.class);
+    private final Object weightLock = new Object();
+    private final ConcurrentLinkedQueue<FairnessAlert> alerts = new ConcurrentLinkedQueue<>();
+    private final AtomicLong loadSample = new AtomicLong(IDEAL_TICK_BUDGET_NS);
+    private final AtomicReference<LoadLevel> loadLevel = new AtomicReference<>(LoadLevel.NORMAL);
+
+    public SchedulerFairnessMonitor() {
+        for (final TaskCategory category : TaskCategory.values()) {
+            this.stats.put(category, new CategoryStats());
+            this.weights.put(category, new Long2DoubleOpenHashMap());
+        }
+    }
+
+    public FairnessTicket begin(final TaskCategory category, final long taskId, final double configuredWeight) {
+        Objects.requireNonNull(category, "category");
+        final CategoryStats stats = this.stats.get(category);
+        stats.pending.increment();
+        final double weight = Math.max(0.05D, configuredWeight);
+        return new FairnessTicket(category, taskId, System.nanoTime(), weight);
+    }
+
+    public void markExecutionStart(final FairnessTicket ticket, final long startTimeNanos) {
+        if (ticket == null) {
+            return;
+        }
+        final long waitTime = Math.max(0L, startTimeNanos - ticket.enqueueTime());
+        ticket.markStarted(startTimeNanos, waitTime);
+        final CategoryStats stats = this.stats.get(ticket.category());
+        stats.pending.decrement();
+        stats.waitTotal.add(waitTime);
+        stats.lastObservedWait.set(waitTime);
+
+        if (waitTime >= STARVATION_THRESHOLD_NS) {
+            stats.tryPublishAlert(ticket.category(), ticket.taskId(), waitTime, this.alerts);
+        }
+    }
+
+    public void markExecutionEnd(final FairnessTicket ticket, final long endTimeNanos) {
+        if (ticket == null) {
+            return;
+        }
+        final long execTime = ticket.startTime() == 0L ? 0L : Math.max(0L, endTimeNanos - ticket.startTime());
+        final CategoryStats stats = this.stats.get(ticket.category());
+        stats.execTotal.add(execTime);
+        stats.completed.increment();
+        stats.lastObservedExec.set(execTime);
+        this.sampleLoad(ticket.category(), execTime + ticket.waitTime());
+    }
+
+    public void cancel(final FairnessTicket ticket) {
+        if (ticket == null) {
+            return;
+        }
+        this.stats.get(ticket.category()).pending.decrement();
+    }
+
+    private void sampleLoad(final TaskCategory category, final long demand) {
+        if (category != TaskCategory.REGION) {
+            return;
+        }
+        long prev;
+        long updated;
+        do {
+            prev = this.loadSample.get();
+            updated = prev - (prev / LOAD_SMOOTHING) + (demand / LOAD_SMOOTHING);
+        } while (!this.loadSample.compareAndSet(prev, updated));
+
+        final double ratio = (double)updated / (double)IDEAL_TICK_BUDGET_NS;
+        final LoadLevel target;
+        if (ratio >= 1.15D) {
+            target = LoadLevel.HIGH;
+        } else if (ratio <= 0.65D) {
+            target = LoadLevel.LOW;
+        } else {
+            target = LoadLevel.NORMAL;
+        }
+        this.loadLevel.set(target);
+    }
+
+    public FairnessAdvice advise(final TaskCategory category, final double configuredWeight, final long waitNanos) {
+        final double weight = Math.max(0.05D, configuredWeight);
+        final LoadLevel level = this.loadLevel.get();
+
+        int queueLevel = Math.max(0, 3 - category.importance());
+        long offset = 0L;
+
+        if (waitNanos >= STARVATION_THRESHOLD_NS) {
+            queueLevel = 0;
+        } else if (waitNanos >= TimeUnit.SECONDS.toNanos(2L)) {
+            queueLevel = Math.min(queueLevel, 1);
+            offset = -TimeUnit.MILLISECONDS.toNanos(4L);
+        } else if (waitNanos >= TimeUnit.MILLISECONDS.toNanos(250L)) {
+            queueLevel = Math.min(queueLevel, 2);
+        }
+
+        if (weight >= 2.0D) {
+            queueLevel = Math.max(0, queueLevel - 1);
+        }
+
+        switch (level) {
+            case HIGH -> queueLevel = Math.max(0, queueLevel - 1);
+            case LOW -> queueLevel = Math.min(3, queueLevel + 1);
+            default -> {}
+        }
+
+        return new FairnessAdvice(queueLevel, offset, weight);
+    }
+
+    public void updateWeight(final TaskCategory category, final long id, final double weight) {
+        final Long2DoubleMap map = this.weights.get(category);
+        synchronized (this.weightLock) {
+            if (weight <= 0.0D) {
+                map.remove(id);
+            } else {
+                map.put(id, weight);
+            }
+        }
+    }
+
+    public double resolveWeight(final TaskCategory category, final long id, final double defaultWeight) {
+        final Long2DoubleMap map = this.weights.get(category);
+        synchronized (this.weightLock) {
+            final double weight = map.getOrDefault(id, defaultWeight);
+            return weight <= 0.0D ? defaultWeight : weight;
+        }
+    }
+
+    public LoadLevel getLoadLevel() {
+        return this.loadLevel.get();
+    }
+
+    public List<FairnessAlert> drainAlerts() {
+        final List<FairnessAlert> drained = new ArrayList<>();
+        FairnessAlert alert;
+        while ((alert = this.alerts.poll()) != null) {
+            drained.add(alert);
+        }
+        return drained;
+    }
+
+    public MetricsSnapshot snapshot() {
+        final EnumMap<TaskCategory, CategoryMetrics> result = new EnumMap<>(TaskCategory.class);
+        for (final Map.Entry<TaskCategory, CategoryStats> entry : this.stats.entrySet()) {
+            final TaskCategory category = entry.getKey();
+            final CategoryStats stats = entry.getValue();
+            final long completed = stats.completed.sum();
+            final long waitAvg = completed == 0L ? 0L : stats.waitTotal.longValue() / completed;
+            final long execAvg = completed == 0L ? 0L : stats.execTotal.longValue() / completed;
+            result.put(category, new CategoryMetrics(waitAvg, execAvg, stats.pending.sum(), completed));
+        }
+        return new MetricsSnapshot(System.nanoTime(), this.loadLevel.get(), Collections.unmodifiableMap(result));
+    }
+
+    public enum LoadLevel {
+        LOW,
+        NORMAL,
+        HIGH
+    }
+
+    public record FairnessAdvice(int queueLevel, long startOffsetNanos, double weight) {}
+
+    public record FairnessAlert(TaskCategory category, long taskId, long waitedNanos) {}
+
+    public record MetricsSnapshot(long generatedAt, LoadLevel loadLevel, Map<TaskCategory, CategoryMetrics> metrics) {}
+
+    public record CategoryMetrics(long averageWaitNanos, long averageExecNanos, long pendingTasks, long completedTasks) {}
+
+    public static final class FairnessTicket {
+        private final TaskCategory category;
+        private final long taskId;
+        private final long enqueueTime;
+        private final double weight;
+        private volatile long startTime;
+        private volatile long waitTime;
+
+        private FairnessTicket(final TaskCategory category, final long taskId, final long enqueueTime, final double weight) {
+            this.category = category;
+            this.taskId = taskId;
+            this.enqueueTime = enqueueTime;
+            this.weight = weight;
+        }
+
+        public TaskCategory category() {
+            return this.category;
+        }
+
+        public long taskId() {
+            return this.taskId;
+        }
+
+        public long enqueueTime() {
+            return this.enqueueTime;
+        }
+
+        public long startTime() {
+            return this.startTime;
+        }
+
+        public long waitTime() {
+            return this.waitTime;
+        }
+
+        public double weight() {
+            return this.weight;
+        }
+
+        private void markStarted(final long startTime, final long waitTime) {
+            this.startTime = startTime;
+            this.waitTime = waitTime;
+        }
+    }
+
+    private static final class CategoryStats {
+        private final LongAdder waitTotal = new LongAdder();
+        private final LongAdder execTotal = new LongAdder();
+        private final LongAdder completed = new LongAdder();
+        private final LongAdder pending = new LongAdder();
+        private final AtomicLong lastAlert = new AtomicLong();
+        private final AtomicLong lastObservedWait = new AtomicLong();
+        private final AtomicLong lastObservedExec = new AtomicLong();
+
+        void tryPublishAlert(final TaskCategory category, final long id, final long waitedNanos,
+                             final ConcurrentLinkedQueue<FairnessAlert> queue) {
+            final long now = System.nanoTime();
+            final long previous = this.lastAlert.get();
+            if ((now - previous) < ALERT_COOLDOWN_NS) {
+                return;
+            }
+            if (this.lastAlert.compareAndSet(previous, now)) {
+                queue.add(new FairnessAlert(category, id, waitedNanos));
+            }
+        }
+    }
+}
