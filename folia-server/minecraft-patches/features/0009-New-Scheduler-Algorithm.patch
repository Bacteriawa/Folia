new file mode 100644
index 0000000000000000000000000000000000000000..7197dc6aa6609656939557917b4ea9bef58c43ff
--- /dev/null
+++ b/io/papermc/paper/threadedregions/scheduler/policy/CooperativeTaskBroker.java
@@ -0,0 +1,87 @@
+package io.papermc.paper.threadedregions.scheduler.policy;
+
+import com.mojang.logging.LogUtils;
+import it.unimi.dsi.fastutil.longs.Long2ObjectOpenHashMap;
+import java.util.ArrayDeque;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Objects;
+import java.util.concurrent.TimeUnit;
+import java.util.function.Consumer;
+import org.slf4j.Logger;
+
+/**
+ * Provides cooperative cross-region task submission. Regions never get
+ * interrupted; instead they poll for pending cooperative requests in
+ * between ticks and execute the payload in-region.
+ */
+public final class CooperativeTaskBroker {
+
+    private static final Logger LOGGER = LogUtils.getLogger();
+    private static final long DEFAULT_TTL_NS = TimeUnit.SECONDS.toNanos(2L);
+
+    private final Object stateLock = new Object();
+    private final Long2ObjectOpenHashMap<CooperativeQueue> queues = new Long2ObjectOpenHashMap<>();
+
+    public void submit(final long regionId, final Runnable runnable) {
+        this.submit(regionId, runnable, DEFAULT_TTL_NS);
+    }
+
+    public void submit(final long regionId, final Runnable runnable, final long ttlNanos) {
+        Objects.requireNonNull(runnable, "runnable");
+        if (regionId <= 0L) {
+            throw new IllegalArgumentException("Region id must be >= 1");
+        }
+        final long expiry = System.nanoTime() + Math.max(1L, ttlNanos);
+        synchronized (this.stateLock) {
+            this.queues.computeIfAbsent(regionId, ignored -> new CooperativeQueue()).push(runnable, expiry);
+        }
+    }
+
+    public void drainTo(final long regionId, final Consumer<Runnable> consumer) {
+        Objects.requireNonNull(consumer, "consumer");
+        final List<Runnable> toRun;
+        synchronized (this.stateLock) {
+            final CooperativeQueue queue = this.queues.get(regionId);
+            if (queue == null) {
+                return;
+            }
+            toRun = queue.drain(System.nanoTime());
+            if (queue.isEmpty()) {
+                this.queues.remove(regionId);
+            }
+        }
+        for (final Runnable runnable : toRun) {
+            try {
+                consumer.accept(runnable);
+            } catch (final Throwable throwable) {
+                LOGGER.error("Failed to execute cooperative task for region {}", regionId, throwable);
+            }
+        }
+    }
+
+    private static final class CooperativeQueue {
+        private final ArrayDeque<Entry> queue = new ArrayDeque<>();
+
+        void push(final Runnable runnable, final long expiry) {
+            this.queue.addLast(new Entry(runnable, expiry));
+        }
+
+        boolean isEmpty() {
+            return this.queue.isEmpty();
+        }
+
+        List<Runnable> drain(final long now) {
+            final List<Runnable> result = new ArrayList<>(this.queue.size());
+            for (Entry entry; (entry = this.queue.pollFirst()) != null;) {
+                if (entry.expiry < now) {
+                    continue;
+                }
+                result.add(entry.runnable);
+            }
+            return result;
+        }
+    }
+
+    private record Entry(Runnable runnable, long expiry) {}
+}
