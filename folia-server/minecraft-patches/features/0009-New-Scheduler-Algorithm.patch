+package io.papermc.paper.threadedregions.scheduling;
+
+import com.mojang.logging.LogUtils;
+import io.papermc.paper.threadedregions.RegionizedServer;
+import net.minecraft.server.level.ServerLevel;
+import org.slf4j.Logger;
+
+public final class UrgentTaskCoordinator {
+
+    private static final Logger LOGGER = LogUtils.getLogger();
+
+    @SuppressWarnings("unused")
+    private final SchedulingServices services;
+
+    UrgentTaskCoordinator(final SchedulingServices services) {
+        this.services = services;
+    }
+
+    public void queueRegionTask(final ServerLevel world, final int chunkX, final int chunkZ, final Runnable run) {
+        if (world == null) {
+            throw new IllegalArgumentException("world");
+        }
+        if (run == null) {
+            throw new IllegalArgumentException("run");
+        }
+
+        final boolean queued = RegionizedServer.getInstance().taskQueue.queueUrgentTask(world, chunkX, chunkZ, run);
+        if (queued) {
+            return;
+        }
+
+        LOGGER.debug("Region not available for urgent task at {},{} in world {}. Falling back to global queue.",
+            Integer.valueOf(chunkX), Integer.valueOf(chunkZ), world.getWorld().getName());
+
+        RegionizedServer.getInstance().addTask(run, RegionizedServer.GlobalTaskPriority.CRITICAL);
+    }
+}
+
