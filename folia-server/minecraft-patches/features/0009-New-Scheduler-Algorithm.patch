+    private static final class GlobalTaskQueue {
+
+        private static final SchedulingServices SCHEDULING_SERVICES = SchedulingServices.get();
+
+        @SuppressWarnings("unchecked")
+        private final ArrayDeque<GlobalTask>[] queues = (ArrayDeque<GlobalTask>[])new ArrayDeque[GlobalTaskPriority.values().length];
+
+        private GlobalTaskQueue() {
+            final GlobalTaskPriority[] priorities = GlobalTaskPriority.values();
+            for (int i = 0; i < priorities.length; ++i) {
+                this.queues[i] = new ArrayDeque<>();
+            }
+        }
+
+        public void add(final Runnable run, final GlobalTaskPriority priority) {
+            Objects.requireNonNull(run, "run");
+            Objects.requireNonNull(priority, "priority");
+            final long enqueueTime = System.nanoTime();
+            final TaskLatencyTracker.Ticket ticket = SCHEDULING_SERVICES.getLatencyTracker().recordEnqueue(TaskType.GLOBAL, enqueueTime);
+            final GlobalTask task = new GlobalTask(run, priority, enqueueTime, ticket);
+            synchronized (this) {
+                this.queues[priority.ordinal()].addLast(task);
+            }
+        }
+
+        public GlobalTask poll() {
+            synchronized (this) {
+                for (int i = 0; i < this.queues.length; ++i) {
+                    final ArrayDeque<GlobalTask> queue = this.queues[i];
+                    final GlobalTask task = queue.pollFirst();
+                    if (task != null) {
+                        return task;
+                    }
+                }
+            }
+            return null;
+        }
+
+        public boolean isEmpty() {
+            synchronized (this) {
+                for (final ArrayDeque<GlobalTask> queue : this.queues) {
+                    if (!queue.isEmpty()) {
+                        return false;
+                    }
+                }
+                return true;
+            }
+        }
+
+        public static final class GlobalTask implements Runnable {
+
+            private final Runnable run;
+            private final GlobalTaskPriority priority;
+            private final long enqueueNanoTime;
+            private final TaskLatencyTracker.Ticket ticket;
+
+            private GlobalTask(final Runnable run, final GlobalTaskPriority priority, final long enqueueNanoTime, final TaskLatencyTracker.Ticket ticket) {
+                this.run = run;
+                this.priority = priority;
+                this.enqueueNanoTime = enqueueNanoTime;
+                this.ticket = ticket;
+            }
+
+            @Override
+            public void run() {
+                try {
+                    this.run.run();
+                } finally {
+                    this.publishMetrics();
+                }
+            }
+
+            private void publishMetrics() {
+                try {
+                    if (this.ticket != null) {
+                        SCHEDULING_SERVICES.getLatencyTracker().recordExecution(this.ticket);
+                    }
+                    final long wait = Math.max(0L, System.nanoTime() - this.enqueueNanoTime);
+                    SCHEDULING_SERVICES.getMetricsCollector().recordExecution(0L, TaskType.GLOBAL, wait);
+                } catch (final Throwable throwable) {
+                    // Metrics collection failure should not interrupt task execution
+                    // Log but don't propagate
+                }
+            }
+
+        }
+    }
 }
