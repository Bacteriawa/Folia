diff --git a/io/papermc/paper/threadedregions/scheduling/TaskLatencyTracker.java b/io/papermc/paper/threadedregions/scheduling/TaskLatencyTracker.java
new file mode 100644
index 0000000000000000000000000000000000000000..3d09d2f96778a0dbcf96b3a99654924e98e19e8f
--- /dev/null
+++ b/io/papermc/paper/threadedregions/scheduling/TaskLatencyTracker.java
@@ -0,0 +1,131 @@
+package io.papermc.paper.threadedregions.scheduling;
+
+import java.util.EnumMap;
+import java.util.Map;
+import java.util.Objects;
+import java.util.concurrent.atomic.AtomicLong;
+import java.util.concurrent.atomic.DoubleAdder;
+import java.util.concurrent.atomic.LongAdder;
+
+public final class TaskLatencyTracker {
+
+    private final EnumMap<TaskType, LatencyAccumulator> accumulators = new EnumMap<>(TaskType.class);
+
+    public TaskLatencyTracker() {
+        for (final TaskType type : TaskType.values()) {
+            this.accumulators.put(type, new LatencyAccumulator());
+        }
+    }
+
+    public Ticket recordEnqueue(final TaskType type) {
+        return new Ticket(type, System.nanoTime());
+    }
+
+    public Ticket recordEnqueue(final TaskType type, final long enqueueNanoTime) {
+        return new Ticket(type, enqueueNanoTime);
+    }
+
+    public void recordExecution(final Ticket ticket) {
+        if (ticket == null) {
+            return;
+        }
+        final long waitTime = System.nanoTime() - ticket.enqueueNanoTime();
+        this.recordWait(ticket.type(), Math.max(waitTime, 0L));
+    }
+
+    public void recordWait(final TaskType type, final long waitNanoseconds) {
+        Objects.requireNonNull(type, "type");
+        if (waitNanoseconds < 0L) {
+            return;
+        }
+        final LatencyAccumulator accumulator = this.accumulators.get(type);
+        if (accumulator != null) {
+            accumulator.totalWait.add(waitNanoseconds);
+            accumulator.taskCount.increment();
+            accumulator.totalWaitSquares.add((double)waitNanoseconds * (double)waitNanoseconds);
+            accumulator.maxWait.accumulateAndGet(waitNanoseconds, Math::max);
+            accumulator.minWait.accumulateAndGet(waitNanoseconds, Math::min);
+        }
+    }
+
+    public LatencyMetrics snapshot(final TaskType type) {
+        Objects.requireNonNull(type, "type");
+        final LatencyAccumulator accumulator = this.accumulators.get(type);
+        return accumulator.snapshot();
+    }
+
+    public Map<TaskType, LatencyMetrics> snapshotAll() {
+        final EnumMap<TaskType, LatencyMetrics> snapshot = new EnumMap<>(TaskType.class);
+        for (final Map.Entry<TaskType, LatencyAccumulator> entry : this.accumulators.entrySet()) {
+            snapshot.put(entry.getKey(), entry.getValue().snapshot());
+        }
+        return snapshot;
+    }
+
+    public record Ticket(TaskType type, long enqueueNanoTime) {}
+
+    public static final class LatencyMetrics {
+
+        public static final LatencyMetrics EMPTY = new LatencyMetrics(0L, 0D, 0D, 0L, 0L);
+
+        private final long taskCount;
+        private final double averageWait;
+        private final double standardDeviation;
+        private final long maxWait;
+        private final long minWait;
+
+        private LatencyMetrics(final long taskCount, final double averageWait, final double standardDeviation,
+                               final long maxWait, final long minWait) {
+            this.taskCount = taskCount;
+            this.averageWait = averageWait;
+            this.standardDeviation = standardDeviation;
+            this.maxWait = maxWait;
+            this.minWait = minWait;
+        }
+
+        public long taskCount() {
+            return this.taskCount;
+        }
+
+        public double averageWait() {
+            return this.averageWait;
+        }
+
+        public double standardDeviation() {
+            return this.standardDeviation;
+        }
+
+        public long maxWait() {
+            return this.maxWait;
+        }
+
+        public long minWait() {
+            return this.minWait;
+        }
+    }
+
+    private static final class LatencyAccumulator {
+
+        private final LongAdder totalWait = new LongAdder();
+        private final DoubleAdder totalWaitSquares = new DoubleAdder();
+        private final LongAdder taskCount = new LongAdder();
+        private final AtomicLong maxWait = new AtomicLong();
+        private final AtomicLong minWait = new AtomicLong(Long.MAX_VALUE);
+
+        private LatencyMetrics snapshot() {
+            final long count = this.taskCount.sum();
+            if (count == 0L) {
+                return LatencyMetrics.EMPTY;
+            }
+            final double total = this.totalWait.sum();
+            final double avg = total / (double)count;
+            final double squares = this.totalWaitSquares.sum();
+            final double variance = Math.max(0D, (squares / (double)count) - (avg * avg));
+            final double stdDev = Math.sqrt(variance);
+            final long max = this.maxWait.get();
+            final long min = this.minWait.get();
+            return new LatencyMetrics(count, avg, stdDev, max, min == Long.MAX_VALUE ? 0L : min);
+        }
+    }
+}
+
