+package io.papermc.paper.threadedregions.scheduling;
+
+public enum TaskType {
+
+    REGION,
+
+    ENTITY,
+
+    GLOBAL,
+
+    IO;
+
+    public boolean isRegionBound() {
+        return this == REGION || this == ENTITY || this == IO;
+    }
+}
