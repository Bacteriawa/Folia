@@ -0,0 +1,90 @@
+package io.papermc.paper.threadedregions.monitoring;
+
+import io.papermc.paper.threadedregions.scheduling.TaskType;
+
+import java.util.Objects;
+import java.util.concurrent.ConcurrentHashMap;
+import java.util.concurrent.ConcurrentMap;
+import java.util.concurrent.atomic.AtomicInteger;
+import java.util.concurrent.atomic.AtomicLong;
+
+public final class FairnessMonitor {
+
+    private final SchedulerMetricsCollector collector;
+    private final ConcurrentMap<Long, RegionFairnessState> regionStates = new ConcurrentHashMap<>();
+    private volatile long starvationThresholdNanos;
+    private volatile int starvationWarningLimit;
+
+    public FairnessMonitor(final SchedulerMetricsCollector collector, final long starvationThresholdNanos, final int starvationWarningLimit) {
+        this.collector = Objects.requireNonNull(collector, "collector");
+        this.starvationThresholdNanos = Math.max(starvationThresholdNanos, 0L);
+        this.starvationWarningLimit = Math.max(starvationWarningLimit, 1);
+    }
+
+    public void setStarvationThresholdNanos(final long starvationThresholdNanos) {
+        this.starvationThresholdNanos = Math.max(starvationThresholdNanos, 0L);
+    }
+
+    public void setStarvationWarningLimit(final int starvationWarningLimit) {
+        this.starvationWarningLimit = Math.max(starvationWarningLimit, 1);
+    }
+
+    public SchedulerMetricsCollector getCollector() {
+        return this.collector;
+    }
+
+    public void onTaskExecution(final long regionId, final TaskType type, final long waitNanoseconds) {
+        this.collector.recordExecution(regionId, type, waitNanoseconds);
+        if (!type.isRegionBound()) {
+            return;
+        }
+        final long threshold = this.starvationThresholdNanos;
+        if (waitNanoseconds < threshold) {
+            this.resetRegion(regionId);
+            return;
+        }
+
+        final RegionFairnessState state = this.regionStates.computeIfAbsent(regionId, RegionFairnessState::new);
+        final int current = state.consecutiveBreaches.incrementAndGet();
+        state.lastObservedWait.set(waitNanoseconds);
+        if (current >= this.starvationWarningLimit) {
+            state.consecutiveBreaches.set(0);
+            this.collector.notifyStarvation(regionId, waitNanoseconds);
+            state.lastAlertTime.set(System.nanoTime());
+        }
+    }
+
+    public void resetRegion(final long regionId) {
+        final RegionFairnessState state = this.regionStates.get(regionId);
+        if (state != null) {
+            state.consecutiveBreaches.set(0);
+            state.lastObservedWait.set(0L);
+        }
+    }
+
+    public RegionState snapshotRegion(final long regionId) {
+        final RegionFairnessState state = this.regionStates.get(regionId);
+        if (state == null) {
+            return RegionState.EMPTY;
+        }
+        return new RegionState(state.regionId, state.consecutiveBreaches.get(), state.lastObservedWait.get(), state.lastAlertTime.get());
+    }
+
+    private static final class RegionFairnessState {
+
+        @SuppressWarnings("unused")
+        private final long regionId;
+        private final AtomicInteger consecutiveBreaches = new AtomicInteger();
+        private final AtomicLong lastObservedWait = new AtomicLong();
+        private final AtomicLong lastAlertTime = new AtomicLong();
+
+        private RegionFairnessState(final long regionId) {
+            this.regionId = regionId;
+        }
+    }
+
+    public record RegionState(long regionId, int consecutiveBreaches, long lastObservedWait, long lastAlertTime) {
+        public static final RegionState EMPTY = new RegionState(-1L, 0, 0L, 0L);
+    }
+}
+
