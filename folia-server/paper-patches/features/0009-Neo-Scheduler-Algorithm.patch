+    private int classifyLane(final long delay) {
+        if (delay <= 2L) {
+            return 0;
+        }
+        if (delay <= 10L) {
+            return 1;
+        }
+        return 2;
+    }
+
+    private void enqueueByLane(final List<QueuedTask> tasks, final double fairnessWeight) {
+        if (tasks.isEmpty()) {
+            return;
+        }
+        final SchedulerFairnessMonitor monitor = TickRegionScheduler.getFairnessMonitor();
+        final long now = System.nanoTime();
+        final PriorityQueue<LaneEntry>[] lanes = new PriorityQueue[MAX_TASK_LANES];
+        for (int i = 0; i < lanes.length; ++i) {
+            lanes[i] = new PriorityQueue<>((first, second) -> {
+                final int priorityCompare = Long.compare(first.priority(), second.priority());
+                if (priorityCompare != 0) {
+                    return priorityCompare;
+                }
+                return System.identityHashCode(first.task()) - System.identityHashCode(second.task());
+            });
+        }
+        for (final QueuedTask task : tasks) {
+            task.age(now);
+            final long wait = Math.max(0L, now - task.creationNanos());
+            final SchedulerFairnessMonitor.FairnessAdvice baseAdvice = monitor.advise(TaskCategory.ENTITY, fairnessWeight, wait);
+            final SchedulerFairnessMonitor.FairnessAdvice effectiveAdvice = monitor.applyPriorityBoost(
+                TaskCategory.ENTITY, this.entity.getEntityId(), baseAdvice
+            );
+            task.promoteTo(effectiveAdvice.queueLevel(), now);
+            final long priority = this.saturatingAdd(task.creationNanos(), effectiveAdvice.startOffsetNanos());
+            lanes[task.lane()].add(new LaneEntry(task, priority));
+        }
+        this.distributeLanes(lanes);
+    }
+
+    private void distributeLanes(final PriorityQueue<LaneEntry>[] lanes) {
+        boolean firstRound = true;
+        while (true) {
+            boolean moved = false;
+            for (int lane = 0; lane < lanes.length; ++lane) {
+                final int configuredBurst = lane < LANE_DISPATCH_QUANTUM.length ? LANE_DISPATCH_QUANTUM[lane] : 1;
+                int quota = firstRound ? configuredBurst : 1;
+                quota = Math.max(1, quota);
+                while (quota > 0 && !lanes[lane].isEmpty()) {
+                    this.currentlyExecuting.addLast(lanes[lane].poll().task());
+                    --quota;
+                    moved = true;
+                }
+            }
+            firstRound = false;
+            if (!moved) {
+                break;
+            }
+        }
+    }
+
+    private void rebalanceDeferredTasks(final double fairnessWeight) {
+        if (this.currentlyExecuting.isEmpty()) {
+            return;
+        }
+        final ArrayList<QueuedTask> spillover = new ArrayList<>(this.currentlyExecuting);
+        this.currentlyExecuting.clear();
+        this.enqueueByLane(spillover, fairnessWeight);
+    }
+
+    private void markDeferredTasks() {
+        if (this.currentlyExecuting.isEmpty()) {
+            return;
+        }
+        final long now = System.nanoTime();
+        for (final QueuedTask queued : this.currentlyExecuting) {
+            queued.demote(now);
+        }
+    }
+
+    private long saturatingAdd(final long value, final long delta) {
+        final long result = value + delta;
+        if (((value ^ result) & (delta ^ result)) < 0) {
+            return delta < 0 ? Long.MIN_VALUE : Long.MAX_VALUE;
+        }
+        return result;
+    }
+
+    private record LaneEntry(QueuedTask task, long priority) {}
