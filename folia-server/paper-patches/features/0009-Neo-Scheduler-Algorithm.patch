+    private static final class QueuedTask {
+
+        private final ScheduledTask task;
+        private int lane;
+        private final long creationNanos;
+        private long lastLaneUpdate;
+        private SchedulerFairnessMonitor.FairnessTicket fairnessTicket;
+
+        private QueuedTask(final ScheduledTask task, final int lane, final long creationNanos,
+                           final SchedulerFairnessMonitor.FairnessTicket fairnessTicket) {
+            this.task = task;
+            this.lane = clampLane(lane);
+            this.creationNanos = creationNanos;
+            this.lastLaneUpdate = creationNanos;
+            this.fairnessTicket = fairnessTicket;
+        }
+
+        private ScheduledTask task() {
+            return this.task;
+        }
+
+        private long creationNanos() {
+            return this.creationNanos;
+        }
+
+        private int lane() {
+            return this.lane;
+        }
+
+        private void promoteTo(final int candidateLane, final long now) {
+            final int clamped = clampLane(candidateLane);
+            if (clamped < this.lane) {
+                this.lane = clamped;
+                this.lastLaneUpdate = now;
+            }
+        }
+
+        private void demote(final long now) {
+            if (this.lane < MAX_TASK_LANES - 1) {
+                ++this.lane;
+                this.lastLaneUpdate = now;
+            }
+        }
+
+        private void age(final long now) {
+            if (this.lane == 0) {
+                return;
+            }
+            if (now - this.lastLaneUpdate >= LANE_AGING_NS) {
+                --this.lane;
+                this.lastLaneUpdate = now;
+            }
+        }
+
+        private void markFairnessStart(final SchedulerFairnessMonitor monitor, final long startTime) {
+            if (this.fairnessTicket != null) {
+                monitor.markExecutionStart(this.fairnessTicket, startTime);
+            }
+        }
+
+        private void markFairnessEnd(final SchedulerFairnessMonitor monitor, final long endTime) {
+            if (this.fairnessTicket != null) {
+                monitor.markExecutionEnd(this.fairnessTicket, endTime);
+                this.fairnessTicket = null;
+            }
+        }
+
+        private void cancelFairness(final SchedulerFairnessMonitor monitor) {
+            if (this.fairnessTicket != null) {
+                monitor.cancel(this.fairnessTicket);
+                this.fairnessTicket = null;
+            }
+        }
+
+        private static int clampLane(final int lane) {
+            return Math.max(0, Math.min(MAX_TASK_LANES - 1, lane));
+        }
+    }
 
