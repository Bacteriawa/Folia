+    private void dispatchFairly(final List<GlobalScheduledTask> tasks) {
+        if (tasks.isEmpty()) {
+            return;
+        }
+        final int lanes = 4;
+        final SchedulerFairnessMonitor monitor = TickRegionScheduler.getFairnessMonitor();
+        final SchedulerFairnessMonitor.LoadLevel loadLevel = monitor.getLoadLevel();
+        final ThresholdProfile thresholds = this.currentThresholdProfile(loadLevel);
+        final PriorityQueue<LaneEntry>[] laneQueues = new PriorityQueue[lanes];
+        for (int i = 0; i < lanes; ++i) {
+            laneQueues[i] = this.createLaneQueue();
+        }
+        final PriorityQueue<LaneEntry> ioLane = this.createLaneQueue();
+        final long now = System.nanoTime();
+        for (final GlobalScheduledTask task : tasks) {
+            final long wait = Math.max(0L, now - task.creationNanos);
+            final double configuredWeight = monitor.resolveWeight(TaskCategory.GLOBAL, task.taskId, 1.0D);
+            final SchedulerFairnessMonitor.FairnessAdvice baseAdvice = monitor.advise(TaskCategory.GLOBAL, configuredWeight, wait);
+            final SchedulerFairnessMonitor.FairnessAdvice advice = monitor.applyPriorityBoost(TaskCategory.GLOBAL, task.taskId, baseAdvice);
+            final PluginTaskStats stats = this.pluginStats.computeIfAbsent(task.plugin, ignored -> new PluginTaskStats());
+            final int lane = this.resolveLane(advice.queueLevel(), stats.currentQueueLevel(now), advice.weight(), lanes);
+            final long predictedExec = stats.predictedExecNanos();
+            final long basePriority = this.saturatingAdd(task.creationNanos, advice.startOffsetNanos());
+            final long adjustedPriority = this.applyPriorityModifiers(basePriority, wait, predictedExec, advice.weight(), task.getScheduledTick(), thresholds);
+            final LaneEntry entry = new LaneEntry(task, adjustedPriority);
+            if (predictedExec >= thresholds.ioHeavyThresholdNs()) {
+                ioLane.add(entry);
+            } else {
+                laneQueues[lane].add(entry);
+            }
+        }
+        this.executeWithWorkStealing(laneQueues, ioLane, loadLevel);
+    }
+
+    private PriorityQueue<LaneEntry> createLaneQueue() {
+        return new PriorityQueue<>((first, second) -> {
+            final int priorityCompare = Long.compare(first.priority(), second.priority());
+            if (priorityCompare != 0) {
+                return priorityCompare;
+            }
+            final int createdCompare = Long.compare(first.task().creationNanos, second.task().creationNanos);
+            if (createdCompare != 0) {
+                return createdCompare;
+            }
+            return Long.compare(first.task().taskId, second.task().taskId);
+        });
+    }
+
+    private int resolveLane(final int queueLevel, final int feedback, final double adviceWeight, final int lanes) {
+        int lane = Math.min(lanes - 1, Math.max(0, queueLevel + feedback));
+        if (adviceWeight <= 0.75D) {
+            lane = Math.max(0, lane - 1);
+        } else if (adviceWeight >= 1.5D) {
+            lane = Math.min(lanes - 1, lane + 1);
+        }
+        return lane;
+    }
+
+    private long applyPriorityModifiers(final long basePriority, final long waitNanos, final long predictedExecNanos,
+                                        final double configuredWeight, final long scheduledTick, final ThresholdProfile thresholds) {
+        final long wsjfBias = this.computeWsjfBias(waitNanos, predictedExecNanos, configuredWeight, thresholds);
+        final long deadlineBias = this.computeDeadlineBias(scheduledTick, thresholds);
+        long priority = this.saturatingAdd(basePriority, -wsjfBias);
+        priority = this.saturatingAdd(priority, -deadlineBias);
+        return priority;
+    }
+
+    private long computeWsjfBias(final long waitNanos, final long predictedExecNanos, final double configuredWeight,
+                                 final ThresholdProfile thresholds) {
+        final double waitMillis = (double)waitNanos / 1.0E6D;
+        final double costOfDelay = Math.max(1.0D, configuredWeight) * (1.0D + waitMillis);
+        final double jobSize = Math.max(1_000.0D, (double)predictedExecNanos);
+        final double ratio = costOfDelay / jobSize;
+        final long scaled = (long)Math.min(thresholds.wsjfBiasLimitNs(), ratio * TimeUnit.MILLISECONDS.toNanos(5L));
+        return Math.max(0L, scaled);
+    }
+
+    private long computeDeadlineBias(final long scheduledTick, final ThresholdProfile thresholds) {
+        final long latenessTicks = Math.max(0L, this.tickCount - scheduledTick);
+        if (latenessTicks == 0L) {
+            return 0L;
+        }
+        final long scaled;
+        try {
+            scaled = Math.multiplyExact(latenessTicks, thresholds.edfBiasPerTickNs());
+        } catch (final ArithmeticException ignored) {
+            return thresholds.wsjfBiasLimitNs();
+        }
+        return Math.min(thresholds.wsjfBiasLimitNs(), Math.max(0L, scaled));
+    }
+
+    private void executeWithWorkStealing(final PriorityQueue<LaneEntry>[] laneQueues, final PriorityQueue<LaneEntry> ioLane,
+                                         final SchedulerFairnessMonitor.LoadLevel loadLevel) {
+        final boolean allowSteal = loadLevel != SchedulerFairnessMonitor.LoadLevel.LOW;
+        boolean progressed;
+        do {
+            progressed = false;
+            for (final PriorityQueue<LaneEntry> lane : laneQueues) {
+                LaneEntry entry = lane.poll();
+                if (entry == null && allowSteal) {
+                    entry = ioLane.poll();
+                }
+                if (entry != null) {
