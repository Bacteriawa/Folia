+    private static final class PluginTaskStats {
+        private final LongAdder execTotal = new LongAdder();
+        private final LongAdder runs = new LongAdder();
+        private final AtomicInteger feedbackLevel = new AtomicInteger();
+        private final AtomicLong lastRun = new AtomicLong(System.nanoTime());
+
+        void recordExecution(final long nanos, final ThresholdProfile thresholds) {
+            final long clamped = Math.max(0L, nanos);
+            this.execTotal.add(clamped);
+            this.runs.increment();
+            this.lastRun.set(System.nanoTime());
+            if (clamped >= thresholds.heavyThresholdNs()) {
+                this.feedbackLevel.updateAndGet(level -> Math.min(3, level + 1));
+            } else if (clamped <= thresholds.lightThresholdNs()) {
+                this.feedbackLevel.updateAndGet(level -> Math.max(0, level - 1));
+            }
+        }
