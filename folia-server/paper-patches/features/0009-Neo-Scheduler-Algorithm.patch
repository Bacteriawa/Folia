+    private ThresholdProfile currentThresholdProfile(final SchedulerFairnessMonitor.LoadLevel loadLevel) {
+        return switch (loadLevel) {
+            case HIGH -> new ThresholdProfile(
+                scaleNs(HEAVY_TASK_THRESHOLD_NS, 0.5D),
+                scaleNs(LIGHT_TASK_THRESHOLD_NS, 0.5D),
