+    private static long scaleNs(final long base, final double multiplier) {
+        final double scaled = Math.max(1.0D, base * multiplier);
+        if (scaled >= Long.MAX_VALUE) {
+            return Long.MAX_VALUE;
+        }
+        return (long)scaled;
+    }
