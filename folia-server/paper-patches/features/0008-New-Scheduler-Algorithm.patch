+            this.fairnessTicket = TickRegionScheduler.getFairnessMonitor().begin(TaskCategory.GLOBAL, taskId, 1.0D);
         }
 
         private final int getStateVolatile() {
@@ -175,6 +205,9 @@ public class FoliaGlobalRegionScheduler implements GlobalRegionScheduler {
                 return;
             }
 
+            final SchedulerFairnessMonitor monitor = TickRegionScheduler.getFairnessMonitor();
+            final long start = System.nanoTime();
+            monitor.markExecutionStart(this.fairnessTicket, start);
             try {
                 this.run.accept(this);
             } catch (final Throwable throwable) {
@@ -187,9 +220,13 @@ public class FoliaGlobalRegionScheduler implements GlobalRegionScheduler {
                     reschedule = true;
                 } // else: cancelled repeating task
 
+                final long end = System.nanoTime();
+                monitor.markExecutionEnd(this.fairnessTicket, end);
                 if (!reschedule) {
                     this.run = null;
+                    this.disposeFairnessTicket();
                 } else {
+                    this.fairnessTicket = TickRegionScheduler.getFairnessMonitor().begin(TaskCategory.GLOBAL, this.taskId, 1.0D);
                     FoliaGlobalRegionScheduler.this.scheduleInternal(this, this.repeatDelay);
                 }
             }
@@ -213,6 +250,7 @@ public class FoliaGlobalRegionScheduler implements GlobalRegionScheduler {
                         if (STATE_IDLE == (curr = this.compareAndExchangeStateVolatile(STATE_IDLE, STATE_CANCELLED))) {
                             this.state = STATE_CANCELLED;
                             this.run = null;
+                            this.disposeFairnessTicket();
                             return CancelledState.CANCELLED_BY_CALLER;
                         }
                         // try again
@@ -223,6 +261,7 @@ public class FoliaGlobalRegionScheduler implements GlobalRegionScheduler {
                             return CancelledState.RUNNING;
                         }
                         if (STATE_EXECUTING == (curr = this.compareAndExchangeStateVolatile(STATE_EXECUTING, STATE_EXECUTING_CANCELLED))) {
+                            this.disposeFairnessTicket();
                             return CancelledState.NEXT_RUNS_CANCELLED;
                         }
                         // try again
@@ -232,6 +271,7 @@ public class FoliaGlobalRegionScheduler implements GlobalRegionScheduler {
                         return CancelledState.NEXT_RUNS_CANCELLED_ALREADY;
                     }
                     case STATE_FINISHED: {
+                        this.disposeFairnessTicket();
                         return CancelledState.ALREADY_EXECUTED;
                     }
                     case STATE_CANCELLED: {
@@ -263,5 +303,12 @@ public class FoliaGlobalRegionScheduler implements GlobalRegionScheduler {
                 }
             }
         }
+
+        private void disposeFairnessTicket() {
+            if (this.fairnessTicket != null) {
+                TickRegionScheduler.getFairnessMonitor().cancel(this.fairnessTicket);
+                this.fairnessTicket = null;
+            }
+        }
     }
