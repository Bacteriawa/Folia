@@ -41,15 +44,17 @@ public final class EntityScheduler {
     public final CraftEntity entity;
 
     private static final record ScheduledTask(Consumer<? extends Entity> run, Consumer<? extends Entity> retired) {}
+    private static final record QueuedTask(ScheduledTask task, int lane, long createdAt) {}
 
     private long tickCount = 0L;
     private static final long RETIRED_TICK_COUNT = -1L;
     private final Object stateLock = new Object();
-    private final Long2ObjectOpenHashMap<List<ScheduledTask>> oneTimeDelayed = new Long2ObjectOpenHashMap<>();
+    private final Long2ObjectOpenHashMap<List<QueuedTask>> oneTimeDelayed = new Long2ObjectOpenHashMap<>();
     private EntitySchedulerTickList scheduledList;
     private boolean insideScheduledList;
 
-    private final ArrayDeque<ScheduledTask> currentlyExecuting = new ArrayDeque<>();
+    private final ArrayDeque<QueuedTask> currentlyExecuting = new ArrayDeque<>();
+    private static final int MAX_TASK_LANES = 3;
 
     public EntityScheduler(final CraftEntity entity) {
         this.entity = Validate.notNull(entity);
@@ -60,6 +65,32 @@ public final class EntityScheduler {
         return !this.currentlyExecuting.isEmpty() || !this.oneTimeDelayed.isEmpty();
     }
 
+    private int classifyLane(final long delay) {
+        if (delay <= 2L) {
+            return 0;
+        }
+        if (delay <= 10L) {
+            return 1;
+        }
+        return 2;
+    }
+
+    private void enqueueByLane(final List<QueuedTask> tasks) {
+        final ArrayDeque<QueuedTask>[] lanes = new ArrayDeque[MAX_TASK_LANES];
+        for (int i = 0; i < lanes.length; ++i) {
+            lanes[i] = new ArrayDeque<>();
+        }
+        for (final QueuedTask task : tasks) {
+            final int lane = Math.min(task.lane(), MAX_TASK_LANES - 1);
+            lanes[lane].addLast(task);
+        }
+        for (final ArrayDeque<QueuedTask> lane : lanes) {
+            while (!lane.isEmpty()) {
+                this.currentlyExecuting.addLast(lane.pollFirst());
+            }
+        }
+    }
+
     public void registerTo(final EntitySchedulerTickList newTickList) {
         synchronized (this.stateLock) {
             final EntitySchedulerTickList prevList = this.scheduledList;
@@ -131,7 +162,8 @@ public final class EntityScheduler {
 
         // correctly handle and order retiring while running executeTick
         for (int i = 0, len = this.currentlyExecuting.size(); i < len; ++i) {
-            final ScheduledTask task = this.currentlyExecuting.pollFirst();
+            final QueuedTask queued = this.currentlyExecuting.pollFirst();
+            final ScheduledTask task = queued.task();
             final Consumer<Entity> retireTask = (Consumer<Entity>)task.retired;
             if (retireTask == null) {
                 continue;
@@ -140,9 +172,9 @@ public final class EntityScheduler {
             retireTask.accept(thisEntity);
         }
 
-        for (final List<ScheduledTask> tasks : this.oneTimeDelayed.values()) {
+        for (final List<QueuedTask> tasks : this.oneTimeDelayed.values()) {
             for (int i = 0, len = tasks.size(); i < len; ++i) {
-                final ScheduledTask task = tasks.get(i);
+                final ScheduledTask task = tasks.get(i).task();
                 final Consumer<Entity> retireTask = (Consumer<Entity>)task.retired;
                 if (retireTask == null) {
                     continue;
@@ -179,13 +211,16 @@ public final class EntityScheduler {
         Validate.notNull(run, "Run task may not be null");
 
         final ScheduledTask task = new ScheduledTask(run, retired);
+        final int taskLane = this.classifyLane(delay);
         synchronized (this.stateLock) {
             if (this.tickCount == RETIRED_TICK_COUNT) {
                 return false;
             }
+            final long createdAt = this.tickCount;
+            final QueuedTask queuedTask = new QueuedTask(task, taskLane, createdAt);
             this.oneTimeDelayed.computeIfAbsent(this.tickCount + Math.max(1L, delay), (final long keyInMap) -> {
                 return new ArrayList<>();
-            }).add(task);
+            }).add(queuedTask);
 
             if (!this.insideScheduledList && this.scheduledList != null) {
                 this.scheduledList.add(this);
@@ -205,7 +240,12 @@ public final class EntityScheduler {
         final Entity thisEntity = this.entity.getHandleRaw();
 
         TickThread.ensureTickThread(thisEntity, "May not tick entity scheduler asynchronously");
-        final List<ScheduledTask> toRun;
+        final SchedulerFairnessMonitor monitor = TickRegionScheduler.getFairnessMonitor();
+        final SchedulerFairnessMonitor.FairnessTicket fairnessTicket =
+            monitor.begin(TaskCategory.ENTITY, this.entity.getEntityId(), 1.0D);
+        final long fairnessStart = System.nanoTime();
+        monitor.markExecutionStart(fairnessTicket, fairnessStart);
+        final List<QueuedTask> toRun;
         synchronized (this.stateLock) {
             if (this.tickCount == RETIRED_TICK_COUNT) {
                 throw new IllegalStateException("Ticking retired scheduler");
@@ -217,17 +257,11 @@ public final class EntityScheduler {
                 this.insideScheduledList = false;
             }
 
-            if (this.oneTimeDelayed.isEmpty()) {
-                toRun = null;
-            } else {
-                toRun = this.oneTimeDelayed.remove(this.tickCount);
-            }
+            toRun = this.oneTimeDelayed.isEmpty() ? null : this.oneTimeDelayed.remove(this.tickCount);
         }
 
         if (toRun != null) {
-            for (int i = 0, len = toRun.size(); i < len; ++i) {
-                this.currentlyExecuting.addLast(toRun.get(i));
-            }
+            this.enqueueByLane(toRun);
         }
 
         // Note: It is allowed for the tasks executed to retire the entity in a given task.
@@ -237,7 +271,8 @@ public final class EntityScheduler {
                 // in this case, we need to delay the tasks for next tick
                 break;
             }
-            final ScheduledTask task = this.currentlyExecuting.pollFirst();
+            final QueuedTask queuedTask = this.currentlyExecuting.pollFirst();
+            final ScheduledTask task = queuedTask.task();
 
             if (this.tickCount != RETIRED_TICK_COUNT) {
                 ((Consumer<Entity>)task.run).accept(thisEntity);
@@ -247,6 +282,7 @@ public final class EntityScheduler {
                 break;
             }
         }
+        monitor.markExecutionEnd(fairnessTicket, System.nanoTime());
     }
 
     public static final class EntitySchedulerTickList {
diff --git a/src/main/java/io/papermc/paper/threadedregions/scheduler/FoliaGlobalRegionScheduler.java b/src/main/java/io/papermc/paper/threadedregions/scheduler/FoliaGlobalRegionScheduler.java
index d306f911757a4d556c82c0070d4837db87afc497..9575f2b144c259e22bc163942aa98e753667e722 100644
