 import java.util.logging.Level;
 
@@ -17,6 +22,7 @@ public class FoliaGlobalRegionScheduler implements GlobalRegionScheduler {
     private long tickCount = 0L;
     private final Object stateLock = new Object();
     private final Long2ObjectOpenHashMap<List<GlobalScheduledTask>> tasksByDeadline = new Long2ObjectOpenHashMap<>();
+    private final AtomicLong taskIdGenerator = new AtomicLong();
 
     public void tick() {
         final List<GlobalScheduledTask> run;
@@ -33,9 +39,7 @@ public class FoliaGlobalRegionScheduler implements GlobalRegionScheduler {
             return;
         }
 
-        for (int i = 0, len = run.size(); i < len; ++i) {
