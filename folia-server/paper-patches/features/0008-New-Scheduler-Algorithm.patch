-        }
+        this.dispatchFairly(run);
     }
 
     @Override
@@ -65,7 +69,7 @@ public class FoliaGlobalRegionScheduler implements GlobalRegionScheduler {
             throw new IllegalPluginAccessException("Plugin attempted to register task while disabled");
         }
 
-        final GlobalScheduledTask ret = new GlobalScheduledTask(plugin, -1, task);
+        final GlobalScheduledTask ret = new GlobalScheduledTask(plugin, -1, task, this.taskIdGenerator.incrementAndGet());
 
         this.scheduleInternal(ret, delayTicks);
 
@@ -92,7 +96,7 @@ public class FoliaGlobalRegionScheduler implements GlobalRegionScheduler {
             throw new IllegalPluginAccessException("Plugin attempted to register task while disabled");
         }
 
-        final GlobalScheduledTask ret = new GlobalScheduledTask(plugin, periodTicks, task);
+        final GlobalScheduledTask ret = new GlobalScheduledTask(plugin, periodTicks, task, this.taskIdGenerator.incrementAndGet());
 
         this.scheduleInternal(ret, initialDelayTicks);
 
@@ -134,6 +138,27 @@ public class FoliaGlobalRegionScheduler implements GlobalRegionScheduler {
         }
     }
 
+    private void dispatchFairly(final List<GlobalScheduledTask> tasks) {
+        final int lanes = 4;
+        final ArrayDeque<GlobalScheduledTask>[] laneQueues = new ArrayDeque[lanes];
+        for (int i = 0; i < lanes; ++i) {
+            laneQueues[i] = new ArrayDeque<>();
+        }
+        final long now = System.nanoTime();
+        for (final GlobalScheduledTask task : tasks) {
+            final long wait = Math.max(0L, now - task.creationNanos);
+            final SchedulerFairnessMonitor.FairnessAdvice advice =
+                TickRegionScheduler.getFairnessMonitor().advise(TaskCategory.GLOBAL, 1.0D, wait);
+            final int lane = Math.min(lanes - 1, Math.max(0, advice.queueLevel()));
+            laneQueues[lane].addLast(task);
+        }
+        for (final ArrayDeque<GlobalScheduledTask> lane : laneQueues) {
+            while (!lane.isEmpty()) {
+                lane.pollFirst().run();
+            }
+        }
+    }
+
     private final class GlobalScheduledTask implements ScheduledTask, Runnable {
 
         private static final int STATE_IDLE                = 0;
@@ -146,13 +171,18 @@ public class FoliaGlobalRegionScheduler implements GlobalRegionScheduler {
